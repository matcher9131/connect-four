# Development Dockerfile for Next.js + Rust/WASM

FROM node:22-bullseye

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.85.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Install wasm-pack (固定バージョン)
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh -s -- -f
RUN wasm-pack --version > /tmp/wasm-pack-version.txt

# Install wasm-bindgen-cli to match wasm-pack version
RUN cargo install wasm-bindgen-cli --version 0.2.99

# Set working directory
WORKDIR /app

# Keep container running
CMD ["tail", "-f", "/dev/null"]
